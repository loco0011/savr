<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only; trust system CAs only (no user-installed CAs in release). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
